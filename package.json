{
  "name": "toppsvar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "demo": "tsx --tsconfig tsconfig.cli.json --conditions=react-server --env-file-if-exists=.env.local src/cli/demo.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local src/cli/db-migrate.ts",
    "db:dump": "tsx --conditions=react-server src/cli/db-dump.ts",
    "seed:sizing": "tsx --tsconfig tsconfig.cli.json --conditions=react-server src/cli/sizing-game.ts",
    "judge:eval": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli/judge-eval.ts",
    "judge:record": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli/judge-record.ts",
    "judge:smoke": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli/judge-smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
