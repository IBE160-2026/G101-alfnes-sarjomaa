# Toppsvar runs with every value below left as is: no key and no hosted service.
# Copy to .env.local to change something. Empty means unset.

# pglite://<dir>, pglite://:memory:, or postgres(ql)://… for a hosted database
DATABASE_URL=pglite://.data/local
# npm run dev and npm start take PORT from the shell only (PORT=4000 npm run dev),
# because Next reads it before this file. Only npm run demo reads it here.
PORT=3000
# Defaults to http://localhost:${PORT}. https turns on Secure cookies.
APP_BASE_URL=
# Optional. Turns on the live Judge through OpenRouter.
OPENROUTER_API_KEY=
# openrouter, replay or mock. Defaults to openrouter with a key, replay without.
JUDGE_PROVIDER=
JUDGE_MODEL=deepseek/deepseek-v4.1-flash
# 1 shows the demo login hint and band.
DEMO_MODE=
# If set, registration requires this code.
REGISTRATION_CODE=
# If set, enables GET /api/purge with this secret.
CRON_SECRET=
